# The shared set: everything that should exist on every Mac.
#
# Machine-specific additions go into Brewfile.local next to this file. That
# one is not tracked by git, so each Mac can differ without the shared list
# drifting. See Brewfile.local.example.
#
# appdir is deliberately not set here: homebrew/shellenv.sh points casks at
# $HOMEBREW_PREFIX/apps when Homebrew lives inside $HOME, and leaves the
# default (/Applications) alone when it does not.

